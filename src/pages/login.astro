---
import BaseLayout from '../layouts/base-layout.astro';

export const prerender = false;

// Already signed in, so there is nothing to do here.
if (Astro.locals.session) {
  return Astro.redirect('/');
}

const errors: Record<string, string> = {
  denied: 'Discord sign-in was cancelled.',
  state: 'That sign-in link expired. Try again.',
  discord: 'Discord did not answer. Try again in a minute.',
};
const error = errors[Astro.url.searchParams.get('error') ?? ''];
---

<BaseLayout title="Sign in">
  <main id="main">
    <div class="card">
      <h1>Raider Mate</h1>
      <p class="muted">Sign in with the Discord account you raid with.</p>
      {error && <p class="notice">{error}</p>}
      <a class="button" href="/auth/discord">Sign in with Discord</a>
    </div>
  </main>
</BaseLayout>

<style>
  main {
    display: grid;
    place-items: center;
    min-height: 100vh;
    padding: 1.5rem;
  }

  .card {
    width: min(28rem, 100%);
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  p {
    margin: 0;
  }
</style>
