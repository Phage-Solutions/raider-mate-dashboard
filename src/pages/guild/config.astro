---
import DashboardLayout from '../../layouts/dashboard-layout.astro';
import { hasLink } from '../../lib/links';
import { noticeFor } from '../../lib/service-notice';
import type {
  GuildChannels,
  GuildRoles,
  GuildSettings,
  RaidLeadRoles,
  ReminderDelivery,
} from '../../lib/service-types';

export const prerender = false;

const { session, actor, client } = Astro.locals;

if (!session!.selectedGuildId) {
  return Astro.redirect('/guild');
}

const guildId = session!.selectedGuildId;

const NOTICES: Record<string, string> = {
  saved: 'Saved.',
  denied: 'That is not yours to change.',
  invalid: 'Raider Mate would not take that. Check the values and try again.',
  lockout:
    'The highest role has to stay a raid lead, so a guild cannot leave itself unable to run a raid.',
  failed: 'Raider Mate had a problem with that.',
  unreachable: 'Raider Mate is not answering right now.',
};
const notice = NOTICES[Astro.url.searchParams.get('notice') ?? ''];
const noticeIsGood = Astro.url.searchParams.get('notice') === 'saved';

let raidLeads: RaidLeadRoles | null = null;
let settings: GuildSettings | null = null;
let roles: GuildRoles | null = null;
let channels: GuildChannels | null = null;
let failure: string | null = null;

try {
  // Four reads, and the service answers 403 on the two admin-only ones for anybody
  // else. Fetched together so one refusal does not hide the rest of the page.
  const [leadsResult, settingsResult, rolesResult, channelsResult] = await Promise.allSettled([
    client.get<RaidLeadRoles>(actor, `/api/guilds/${guildId}/raid-lead-roles`),
    client.get<GuildSettings>(actor, `/api/guilds/${guildId}/settings`),
    client.get<GuildRoles>(actor, `/api/guilds/${guildId}/discord-roles`),
    client.get<GuildChannels>(actor, `/api/guilds/${guildId}/discord-channels`),
  ]);
  raidLeads = leadsResult.status === 'fulfilled' ? leadsResult.value : null;
  settings = settingsResult.status === 'fulfilled' ? settingsResult.value : null;
  roles = rolesResult.status === 'fulfilled' ? rolesResult.value : null;
  channels = channelsResult.status === 'fulfilled' ? channelsResult.value : null;

  if (settingsResult.status === 'rejected' && !raidLeads) {
    failure = noticeFor(settingsResult.reason);
  }
} catch (error) {
  failure = noticeFor(error);
}

// Rendered from the links the service offered, never from what this repo believes about
// admins. The rel is `replace` because both writes are whole-row PUTs: sending the set
// you want rather than a patch of the bits you changed.
const mayEditRoles = raidLeads !== null && hasLink(raidLeads, 'replace');
const maySaveSettings = settings !== null && hasLink(settings, 'replace');

const mapped = new Set(raidLeads?.role_ids ?? []);
const mentioned = new Set(settings?.event_mention_role_ids ?? []);

// Discord's @everyone role shares the guild's id and is never a useful raid-lead role.
const assignableRoles = (roles?.roles ?? []).filter((role) => role.id !== guildId);

/**
 * The top of the guild's hierarchy, which the service refuses to let anyone unmap. Read
 * from position rather than from the order the list arrived in, so this does not quietly
 * depend on how the service sorts.
 */
const highestRole = assignableRoles.reduce<(typeof assignableRoles)[number] | undefined>(
  (highest, role) => (highest === undefined || role.position > highest.position ? role : highest),
  undefined,
);

const TEXT_CHANNELS = new Set(['TEXT', 'ANNOUNCEMENT']);
const postableChannels = (channels?.channels ?? []).filter((channel) =>
  TEXT_CHANNELS.has(channel.type),
);

const DELIVERIES: { value: ReminderDelivery; label: string }[] = [
  { value: 'PING', label: 'One message in the events channel' },
  { value: 'DM', label: 'A direct message each' },
  { value: 'BOTH', label: 'Both' },
];
---

<DashboardLayout title="Guild configuration">
  <p slot="head" class="muted">
    What Raider Mate does in {session!.selectedGuildName}. Raid leads and server admins can change
    these.
  </p>

  {notice && <p class:list={['notice', noticeIsGood && 'notice--good']}>{notice}</p>}
  {failure && <p class="notice">{failure}</p>}

  {
    !failure && !raidLeads && !settings && (
      <div class="panel">
        <div class="empty">
          <h3>Not yours to change</h3>
          <p>
            Guild configuration is for raid leads and for people with Manage Server in Discord. Ask
            one of them, or look after your own characters instead.
          </p>
          <a class="button button--quiet" href="/characters">
            My characters
          </a>
        </div>
      </div>
    )
  }

  {
    raidLeads && (
      <section class="panel">
        <div class="panel__head">
          <h2>Raid leads</h2>
          <span class="badge">{mapped.size} mapped</span>
        </div>
        <div class="panel__body">
          <p class="muted lead">
            Anyone holding one of these Discord roles can create and edit events, approve late
            requests and lock comps. Everyone else manages their own characters and signups.
          </p>

          {mayEditRoles ? (
            <form method="post" action="/guild/config/roles" data-astro-reload>
              {highestRole && (
                <>
                  {/* Locked on, and submitted by a hidden field because a disabled box
                      sends nothing. The service refuses the write without it either
                      way; this is here so nobody discovers that by being refused. */}
                  <input type="hidden" name="role_ids" value={highestRole.id} />
                  <p class="hint">
                    <strong>{highestRole.name}</strong> stays a raid lead. It is the top of your
                    role hierarchy, and keeping it means somebody can always fix the rest.
                  </p>
                </>
              )}
              <ul class="picks">
                {assignableRoles.map((role) => (
                  <li>
                    <label class:list={['pick', role.id === highestRole?.id && 'pick--locked']}>
                      <input
                        type="checkbox"
                        name="role_ids"
                        value={role.id}
                        checked={mapped.has(role.id) || role.id === highestRole?.id}
                        disabled={role.id === highestRole?.id}
                      />
                      <span
                        class="pick__swatch"
                        style={`background: ${role.color ? `#${role.color.toString(16).padStart(6, '0')}` : 'var(--border-strong)'}`}
                        aria-hidden="true"
                      />
                      <span class="pick__name">{role.name}</span>
                      {role.id === highestRole?.id && <span class="pick__always">Always</span>}
                    </label>
                  </li>
                ))}
              </ul>
              {assignableRoles.length === 0 && (
                <p class="muted">
                  Raider Mate has not seen this server's roles yet. The bot fills that in.
                </p>
              )}
              <button class="button" type="submit">
                Save raid leads
              </button>
            </form>
          ) : (
            <ul class="picks picks--read">
              {assignableRoles
                .filter((role) => mapped.has(role.id))
                .map((role) => (
                  <li class="badge">{role.name}</li>
                ))}
              {mapped.size === 0 && <li class="muted">Nothing mapped yet.</li>}
            </ul>
          )}
        </div>
      </section>
    )
  }

  {
    settings && (
      <section class="panel section">
        <div class="panel__head">
          <h2>Events</h2>
        </div>
        <div class="panel__body">
          <form method="post" action="/guild/config/settings" data-astro-reload>
            <div class="field">
              <label for="events_channel_id">Events channel</label>
              <p class="hint">Where the bot posts raid nights.</p>
              <select id="events_channel_id" name="events_channel_id" disabled={!maySaveSettings}>
                <option value="">Not set</option>
                {postableChannels.map((channel) => (
                  <option value={channel.id} selected={settings.events_channel_id === channel.id}>
                    #{channel.name}
                  </option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="timezone">Guild timezone</label>
              <p class="hint">
                An IANA name such as <code>Europe/Bratislava</code>. Every raid time in Raider Mate
                is shown in this zone, so everyone reads the clock time you announced.
              </p>
              <input
                id="timezone"
                name="timezone"
                type="text"
                value={settings.timezone ?? ''}
                placeholder="Europe/Bratislava"
                disabled={!maySaveSettings}
              />
            </div>

            <div class="field">
              <label for="reminder_lead_minutes">Reminder lead</label>
              <p class="hint">
                Minutes before the start that the reminder fires. 0 means no reminder.
              </p>
              <input
                id="reminder_lead_minutes"
                name="reminder_lead_minutes"
                type="number"
                min="0"
                max="1440"
                value={settings.reminder_lead_minutes ?? ''}
                placeholder="30"
                disabled={!maySaveSettings}
              />
            </div>

            <div class="field">
              <label for="reminder_delivery">Reminder delivery</label>
              <select id="reminder_delivery" name="reminder_delivery" disabled={!maySaveSettings}>
                <option value="">Not set</option>
                {DELIVERIES.map((delivery) => (
                  <option
                    value={delivery.value}
                    selected={settings.reminder_delivery === delivery.value}
                  >
                    {delivery.label}
                  </option>
                ))}
              </select>
            </div>

            <div class="field">
              <span class="label">Mentioned on a new event</span>
              <p class="hint">
                Nobody selected means the bot pings nobody, which is different from not having
                chosen.
              </p>
              <ul class="picks">
                {assignableRoles.map((role) => (
                  <li>
                    <label class="pick">
                      <input
                        type="checkbox"
                        name="event_mention_role_ids"
                        value={role.id}
                        checked={mentioned.has(role.id)}
                        disabled={!maySaveSettings}
                      />
                      <span
                        class="pick__swatch"
                        style={`background: ${role.color ? `#${role.color.toString(16).padStart(6, '0')}` : 'var(--border-strong)'}`}
                        aria-hidden="true"
                      />
                      <span class="pick__name">{role.name}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </div>

            {maySaveSettings && (
              <button class="button" type="submit">
                Save events
              </button>
            )}
          </form>
        </div>
      </section>
    )
  }
</DashboardLayout>

<style>
  .notice--good {
    border-color: color-mix(in srgb, var(--success) 34%, transparent);
    background: color-mix(in srgb, var(--success) 11%, transparent);
  }

  .notice--good::before {
    background: var(--success);
  }

  .lead {
    max-width: 68ch;
    margin-bottom: 1.25rem;
  }

  .picks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.375rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
  }

  .picks--read {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .pick {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.4rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--raised);
    font-size: var(--fs-sm);
    cursor: pointer;
    transition: border-color var(--dur-1) var(--ease);
  }

  .pick:hover {
    border-color: var(--border-strong);
  }

  .pick:has(input:checked) {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .pick:has(input:disabled) {
    cursor: not-allowed;
  }

  /* Locked on rather than greyed out: it is a real, active mapping, it just cannot be
     taken away. */
  .pick--locked {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .pick__always {
    margin-left: auto;
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
  }

  .pick__swatch {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: var(--radius-full);
  }

  .pick__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
