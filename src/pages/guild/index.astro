---
import DashboardLayout from '../../layouts/dashboard-layout.astro';
import { actorBeforeGuildChosen } from '../../lib/actor';
import { fetchGuildAbilities } from '../../lib/capabilities';
import { cookiesSecure, sessionSecret } from '../../lib/config';
import { fetchGuildRoleIds, fetchGuilds, type DiscordGuild } from '../../lib/discord-oauth';
import {
  rememberGuild,
  sealSession,
  SESSION_COOKIE,
  sessionCookieOptions,
} from '../../lib/session';
import type { UserGuild } from '../../lib/service-types';

export const prerender = false;

const session = Astro.locals.session!;
const client = Astro.locals.client;

// Discord's guild list is fetched here rather than carried in the session cookie: a
// raider in fifty guilds would push the cookie past 4KB, and this page is the only one
// that needs the list.
const guilds = await fetchGuilds(session.accessToken);

// Which of those Raider Mate actually knows them in. A raider is in far more Discord
// servers than they raid with, and asking them to find the right one in that pile is
// the thing this page used to get wrong.
let known = new Set<string>();
let serviceAnswered = true;
try {
  const rows = await client.get<UserGuild[]>(
    actorBeforeGuildChosen(session.discordId),
    `/api/users/${session.discordId}/guilds`,
  );
  known = new Set(rows.map((row) => row.discord_guild_id));
} catch (error) {
  // The service being unreachable is not a reason to block the picker. Fall back to the
  // plain list, which is what this page did before it could ask.
  //
  // Logged rather than swallowed: this degrades to a page that looks fine, so a service
  // answering 400 to every call went unnoticed until somebody said their guild was
  // missing from a list that had never been sorted at all.
  console.error('listing the guilds Raider Mate knows this raider in', error);
  serviceAnswered = false;
}

/**
 * One guild, nothing chosen yet, and the service put it in front of us: pick it. The id
 * survives the same check `POST /guild/select` makes, because it came from Discord's own
 * list of this raider's servers rather than from anything a browser sent.
 */
const running = guilds.filter((guild) => known.has(guild.id));
if (!session.selectedGuildId && running.length === 1) {
  const only = running[0]!;
  const roleIds = await fetchGuildRoleIds(session.accessToken, only.id);
  const abilities = await fetchGuildAbilities(
    client,
    { discordId: session.discordId, guildId: only.id, roleIds, guildAdmin: only.admin },
    only.id,
  );
  Astro.cookies.set(
    SESSION_COOKIE,
    await sealSession(
      {
        ...session,
        selectedGuildId: only.id,
        selectedGuildName: only.name,
        roleIds,
        guildAdmin: only.admin,
        abilities,
        actorFetchedAt: Date.now(),
        recentGuildIds: rememberGuild(session.recentGuildIds, only.id),
      },
      sessionSecret,
    ),
    sessionCookieOptions(cookiesSecure),
  );
  return Astro.redirect('/dashboard');
}

// The guilds picked before, in the order they were picked, ahead of everything else.
// For a raider in a handful of servers this is the same list twice over, so it is only
// worth its own section once the pile below it is big enough to be a pile.
const recentIds = session.recentGuildIds ?? [];
const byId = new Map(guilds.map((guild) => [guild.id, guild]));
const recent =
  guilds.length > 8
    ? recentIds.map((id) => byId.get(id)).filter((guild): guild is DiscordGuild => !!guild)
    : [];
const shown = new Set(recent.map((guild) => guild.id));

const groups: {
  heading?: string | undefined;
  note?: string | undefined;
  quiet?: boolean | undefined;
  guilds: DiscordGuild[];
}[] = [
  { heading: 'Recently used', guilds: recent },
  {
    heading: recent.length > 0 ? 'Running Raider Mate' : undefined,
    guilds: guilds.filter((guild) => known.has(guild.id) && !shown.has(guild.id)),
  },
  {
    heading: 'Your other servers',
    note: 'Raider Mate has nothing for these yet. Picking one shows an empty dashboard until the bot is posting events there.',
    quiet: true,
    guilds: guilds.filter((guild) => !known.has(guild.id) && !shown.has(guild.id)),
  },
].filter((group) => group.guilds.length > 0);

// Below this the list fits on a screen and a search field is one more thing to read.
const searchable = guilds.length > 8;

const rejected = Astro.url.searchParams.get('error') === 'guild';

const iconFor = (guild: { id: string; icon: string | null }) =>
  guild.icon ? `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.png?size=64` : null;
---

<DashboardLayout title="Choose a guild">
  <p slot="head" class="muted">
    {
      serviceAnswered && known.size > 0
        ? 'These are the servers Raider Mate already knows you in.'
        : 'Every Discord server you are in is listed. Raider Mate only has data for the ones running it, so the rest will look empty.'
    }
  </p>

  {rejected && <p class="notice">That guild is not one of yours. Pick one from the list.</p>}

  {
    searchable && (
      <div class="search" hidden data-guild-search>
        <label class="visually-hidden" for="guild-search">
          Search your servers
        </label>
        <input
          id="guild-search"
          type="search"
          placeholder="Search servers"
          autocomplete="off"
          spellcheck="false"
        />
      </div>
    )
  }

  {
    groups.map((group) => (
      <section class="group" data-group>
        {group.heading && <h2>{group.heading}</h2>}
        {group.note && <p class="muted">{group.note}</p>}
        <ul>
          {group.guilds.map((guild) => (
            <li data-name={guild.name.toLowerCase()}>
              <form method="post" action="/guild/select" data-astro-reload>
                <input type="hidden" name="guild_id" value={guild.id} />
                <button
                  class:list={['guild', { 'guild--quiet': group.quiet }]}
                  type="submit"
                  aria-current={session.selectedGuildId === guild.id ? 'true' : undefined}
                >
                  {iconFor(guild) ? (
                    <img
                      class="guild__icon"
                      src={iconFor(guild)}
                      alt=""
                      width="32"
                      height="32"
                      loading="lazy"
                    />
                  ) : (
                    <span class="guild__icon guild__icon--letter" aria-hidden="true">
                      {guild.name.slice(0, 1)}
                    </span>
                  )}
                  <span class="guild__name">{guild.name}</span>
                  {session.selectedGuildId === guild.id && <span class="badge">Current</span>}
                </button>
              </form>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    searchable && (
      <p class="muted" hidden data-guild-empty>
        No server matches that.
      </p>
    )
  }
</DashboardLayout>

<script>
  const search = document.querySelector<HTMLElement>('[data-guild-search]');
  const input = search?.querySelector('input');
  const empty = document.querySelector<HTMLElement>('[data-guild-empty]');
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];

  if (search && input) {
    // Revealed from script so a browser without it is never shown a field that does
    // nothing: the filtering only exists here.
    search.hidden = false;

    input.addEventListener('input', () => {
      const term = input.value.trim().toLowerCase();
      let matches = 0;

      for (const group of groups) {
        let visible = 0;
        for (const item of group.querySelectorAll<HTMLElement>('li[data-name]')) {
          const hit = !term || (item.dataset.name ?? '').includes(term);
          item.hidden = !hit;
          if (hit) {
            visible += 1;
          }
        }
        group.hidden = visible === 0;
        matches += visible;
      }

      if (empty) {
        empty.hidden = matches > 0;
      }
    });
  }
</script>

<style>
  .search {
    /* Bottom matches the gap between groups, so the first heading is not crowded
       against the field. */
    margin: 1.5rem 0 2.5rem;
  }

  .search input {
    width: min(100%, 22rem);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text-primary);
    font: inherit;
    font-size: var(--fs-md);
  }

  .search input:focus-visible {
    border-color: var(--accent);
  }

  .group + .group {
    margin-top: 2.5rem;
  }

  .group h2 {
    font-size: var(--fs-lg);
    letter-spacing: -0.014em;
  }

  .group p {
    max-width: 60ch;
    margin-top: 0.375rem;
    font-size: var(--fs-sm);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  li[hidden] {
    display: none;
  }

  .guild {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    width: 100%;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text-primary);
    font: inherit;
    font-size: var(--fs-md);
    font-weight: 560;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease);
  }

  .guild:hover {
    background: var(--hover);
    border-color: var(--border-strong);
  }

  .guild[aria-current='true'] {
    border-color: var(--accent);
  }

  /* The servers Raider Mate has nothing for. Still reachable, just not competing with
     the ones the raider actually came for. */
  .guild--quiet {
    background: transparent;
    color: var(--text-secondary);
    font-weight: 400;
  }

  .guild--quiet .guild__icon {
    opacity: 0.65;
  }

  .guild__icon {
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: var(--radius-full);
    background: var(--raised);
    object-fit: cover;
  }

  .guild__icon--letter {
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    color: var(--text-tertiary);
    font-size: var(--fs-sm);
    text-transform: uppercase;
  }

  .guild__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .guild .badge {
    margin-left: auto;
  }
</style>
