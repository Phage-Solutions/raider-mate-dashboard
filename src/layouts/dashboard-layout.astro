---
import SiteNav from '../components/site-nav.astro';
import BaseLayout from './base-layout.astro';

interface Props {
  title: string;
  /**
   * Pairs the page title with the element it was opened from, so the two morph into
   * each other across the navigation. Only pages reached from a list set it.
   */
  titleTransition?: string | undefined;
}

const { title, titleTransition } = Astro.props;
---

<BaseLayout title={title}>
  <SiteNav />
  <main class="page" id="main">
    <div class="page-head">
      <div class="page-head__title">
        <h1>
          {titleTransition ? <span transition:name={titleTransition}>{title}</span> : title}
        </h1>
        <slot name="head" />
      </div>
      <slot name="actions" />
    </div>
    <slot />
  </main>
</BaseLayout>

<style>
  .page-head__title {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }
</style>
