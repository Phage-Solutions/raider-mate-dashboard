---
import SiteNav from '../components/site-nav.astro';
import BaseLayout from './base-layout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const session = Astro.locals.session;
---

<BaseLayout title={title}>
  <div class="shell">
    <header>
      <a class="brand" href="/">Raider Mate</a>
      <div class="who">
        {
          session?.selectedGuildName && (
            <span class="guild">
              {session.selectedGuildName} <a href="/guild">Change</a>
            </span>
          )
        }
        <span class="muted">{session?.username}</span>
        <form method="post" action="/auth/logout">
          <button class="button button--quiet" type="submit">Sign out</button>
        </form>
      </div>
    </header>

    <div class="body">
      <aside>
        <SiteNav />
      </aside>
      <main id="main">
        <h1>{title}</h1>
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-raised);
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .guild {
    display: inline-flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  .body {
    flex: 1;
    display: grid;
    grid-template-columns: 14rem 1fr;
  }

  aside {
    padding: 1rem;
    border-right: 1px solid var(--border);
    background: var(--surface-raised);
  }

  main {
    padding: 1.5rem;
    max-width: 60rem;
  }

  @media (max-width: 45rem) {
    .body {
      grid-template-columns: 1fr;
    }

    aside {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
  }
</style>
