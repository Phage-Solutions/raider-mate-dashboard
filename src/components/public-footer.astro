---
import { COMPANY_URL, GITHUB_MARK, ORG_URL, REPOS } from '../lib/brand';
---

<footer class="foot">
  <span class="foot__line">
    Raider Mate by <a href={COMPANY_URL} rel="noreferrer">Phage Solutions, s.r.o.</a>{' '}
    AGPL-3.0-or-later.
  </span>

  <nav class="foot__group" aria-label="Source code">
    <a class="foot__org" href={ORG_URL} rel="noreferrer">
      <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path fill="currentColor" d={GITHUB_MARK}></path>
      </svg>
      <span class="visually-hidden">Source on GitHub</span>
    </a>
    {
      REPOS.map((repo) => (
        <a href={repo.href} rel="noreferrer">
          {repo.label}
        </a>
      ))
    }
  </nav>

  <nav class="foot__group" aria-label="Legal">
    <a href="/privacy">Privacy</a>
    <a href="/terms">Terms</a>
  </nav>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: center;
    width: min(var(--page-width), 100%);
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-tertiary);
    font-size: var(--fs-sm);
  }

  .foot__line {
    margin-right: auto;
  }

  .foot__group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.875rem;
    align-items: center;
  }

  .foot__org {
    display: inline-flex;
    align-items: center;
    color: var(--text-tertiary);
  }

  .foot__org:hover {
    color: var(--accent);
  }

  .glyph {
    width: auto;
    height: 1em;
    flex: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 60rem) {
    .foot {
      padding-inline: 2rem;
    }
  }
</style>
