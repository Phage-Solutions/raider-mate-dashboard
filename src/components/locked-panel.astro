---
interface Props {
  title: string;
  /** One plain sentence on what the panel shows. Never a pitch, never an apology. */
  blurb: string;
}

const { title, blurb } = Astro.props;
---

{
  /*
   * A panel the service did not send data for. It renders at full opacity and full
   * contrast: a raid lead has to be able to read what they would be getting, and a
   * blurred chart of invented numbers tells them nothing except that we made some up.
   *
   * This is not a tier check. The page reaches here because the analysis index carried
   * no link for this panel, which is the same absence a lapsed subscription produces.
   */
}
<section class="panel">
  <div class="panel__head">
    <h2>{title}</h2>
    <span class="badge">Premium</span>
  </div>
  <div class="panel__body locked">
    <p class="locked__blurb">{blurb}</p>
    <a class="button" href="/#pricing">See Premium</a>
  </div>
</section>

<style>
  .locked {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    justify-content: space-between;
  }

  /* Short on purpose. Four of these stack under one free panel for a guild that has not
     subscribed, and four full-height billboards would read as a wall rather than as a
     short list of what is behind the door. */
  .locked__blurb {
    max-width: 58ch;
    margin: 0;
    color: var(--text-secondary);
  }
</style>
