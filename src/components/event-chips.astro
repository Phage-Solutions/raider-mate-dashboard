---
import { DIFFICULTY_HUES, DIFFICULTY_LABELS } from '../lib/difficulty';
import type { Event } from '../lib/service-types';

interface Props {
  event: Event;
}

const { event } = Astro.props;

const hue = event.difficulty ? DIFFICULTY_HUES[event.difficulty] : null;
---

<span class="chips">
  <span class="badge">{event.type === 'MYTHIC_PLUS' ? 'Mythic+' : 'Raid'}</span>
  {
    event.difficulty && (
      <span class:list={['badge', hue && 'badge--hue']} style={hue ? `--hue: ${hue}` : undefined}>
        {DIFFICULTY_LABELS[event.difficulty]}
      </span>
    )
  }
</span>

<style>
  .chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    align-items: center;
  }
</style>
