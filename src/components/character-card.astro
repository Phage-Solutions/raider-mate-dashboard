---
import { hasLink } from '../lib/links';
import { classColor } from '../lib/wow-class';
import type { Character, Role } from '../lib/service-types';

interface Props {
  character: Character;
  /** Which roles this character's menu currently carries. */
  roles: Set<Role>;
}

const { character, roles } = Astro.props;

const ROLES: { role: Role; label: string; hue: string }[] = [
  { role: 'TANK', label: 'Tank', hue: 'var(--role-tank)' },
  { role: 'HEALER', label: 'Healer', hue: 'var(--role-healer)' },
  { role: 'MDPS', label: 'Melee', hue: 'var(--role-mdps)' },
  { role: 'RDPS', label: 'Ranged', hue: 'var(--role-rdps)' },
];
---

<section class:list={['panel', 'char', character.is_main && 'char--main']}>
  <div class="panel__head">
    <span
      class="char__mark"
      style={`background: ${classColor(character.class) ?? 'var(--border-strong)'}`}
      aria-hidden="true"></span>
    <h2>
      <a href={character.raiderio_url} rel="noreferrer">{character.name}</a>
      <span class="char__realm">
        {character.realm} &middot; {character.region.toUpperCase()}
      </span>
    </h2>
    {!character.synced && <span class="badge">Not synced yet</span>}
  </div>

  <div class="panel__body">
    <dl class="facts">
      <div>
        <dt>Class</dt>
        <dd>
          {character.class ?? <span class="dash">Unknown</span>}
          {character.spec ? ` ${character.spec}` : ''}
        </dd>
      </div>
      <div>
        <dt>Item level</dt>
        <dd>{character.ilvl ?? <span class="dash">&mdash;</span>}</dd>
      </div>
      <div>
        <dt>Mythic+</dt>
        <dd>{character.mplus_score ?? <span class="dash">&mdash;</span>}</dd>
      </div>
    </dl>

    {
      /* The role menu stays the raider's own, even from a raid lead, so this form
        appears only where the service offered the roles link. */
    }
    {
      hasLink(character, 'roles') ? (
        <form method="post" action={`/characters/${character.id}/roles`} data-astro-reload>
          <span class="label">Can play</span>
          <p class="hint">
            Tick everything this character can bring. The assigner picks from these; it never asks
            you again at signup time.
          </p>
          <ul class="picks">
            {ROLES.map((role) => (
              <li>
                <label class="pick" style={`--hue: ${role.hue}`}>
                  <input
                    type="checkbox"
                    name="roles"
                    value={role.role}
                    checked={roles.has(role.role)}
                  />
                  <span class="pick__dot" aria-hidden="true" />
                  {role.label}
                </label>
              </li>
            ))}
          </ul>
          <button class="button button--quiet" type="submit">
            Save roles
          </button>
        </form>
      ) : (
        <>
          <span class="label">Can play</span>
          <ul class="picks picks--read">
            {ROLES.filter((role) => roles.has(role.role)).map((role) => (
              <li class="badge" style={`--hue: ${role.hue}`}>
                <span class="pick__dot" aria-hidden="true" />
                {role.label}
              </li>
            ))}
            {roles.size === 0 && <li class="muted">Nothing chosen yet.</li>}
          </ul>
        </>
      )
    }

    <div class="char__actions">
      {
        hasLink(character, 'edit') && !character.is_main && (
          <form method="post" action={`/characters/${character.id}/main`} data-astro-reload>
            <button class="button button--quiet" type="submit">
              Make this my main
            </button>
          </form>
        )
      }
      {
        hasLink(character, 'delete') && (
          <form method="post" action={`/characters/${character.id}/remove`} data-astro-reload>
            <button class="button button--ghost" type="submit">
              Remove
            </button>
          </form>
        )
      }
    </div>
  </div>
</section>

<style>
  .char + .char {
    margin-top: 0.75rem;
  }

  /* The main is the character a raid lead actually plans around, so it carries the
     accent rather than a label alone. */
  .char--main {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }

  .char__mark {
    width: 3px;
    height: 1.4em;
    flex: none;
    border-radius: var(--radius-full);
  }

  /* Without this the head's space-between pushes the name into the middle of the bar,
     away from the class marker it belongs to. */
  .char h2 {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    margin-right: auto;
    font-size: var(--fs-lg);
    letter-spacing: -0.014em;
  }

  .char h2 a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .char h2 a:hover {
    color: var(--accent);
  }

  .char__realm {
    color: var(--text-tertiary);
    font-size: var(--fs-sm);
    font-weight: 400;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    margin: 0 0 1.25rem;
  }

  .facts dt {
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
    font-weight: 560;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0.125rem 0 0;
    font-variant-numeric: tabular-nums;
  }

  .picks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0.5rem 0 1rem;
    padding: 0;
    list-style: none;
  }

  .pick {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--raised);
    font-size: var(--fs-sm);
    cursor: pointer;
    transition: border-color var(--dur-1) var(--ease);
  }

  .pick:hover {
    border-color: var(--border-strong);
  }

  .pick:has(input:checked) {
    border-color: color-mix(in srgb, var(--hue) 50%, transparent);
    background: color-mix(in srgb, var(--hue) 13%, transparent);
    color: var(--hue);
  }

  .pick__dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: var(--radius-full);
    background: var(--hue);
  }

  .picks--read .badge {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
  }

  .char__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }
</style>
