---
export interface Segment {
  /** A colour from the system's existing data channels: a role, or a status. */
  hue: string;
  value: number;
  label: string;
}

interface Props {
  segments: Segment[];
  /** What the whole bar adds up to. Zero renders the empty track. */
  total: number;
  /** Read aloud in place of the bar, since the bar itself says nothing to a reader. */
  label: string;
  /** Position in its own list, which is all the stagger needs to know. */
  index?: number | undefined;
}

const { segments, total, label, index = 0 } = Astro.props;

// Zero-width segments still produce a visible sliver at some rounding, and a status
// nobody used should not appear at all.
const drawn = total > 0 ? segments.filter((segment) => segment.value > 0) : [];

// Capped hard. A roster of forty raiders staggered honestly would still be assembling
// half a second after a raid lead started reading it, which is a wait, not a moment.
const STEP_MS = 38;
const MAX_STEPS = 12;
const delay = Math.min(index, MAX_STEPS) * STEP_MS;
---

{
  /*
   * One whole, split by a channel that means something. It is the page's one chart form:
   * the same geometry carries a raider's answers across the season, a comp's roles, and
   * what the roster can play, because in all three the question is what share of a whole
   * each part holds.
   *
   * Colour is never chosen here. It arrives as a hue the caller already had a reason
   * for, which is what keeps this from becoming a palette.
   */
}
<span class="bar" role="img" aria-label={label} style={`--delay: ${delay}ms`}>
  <span class="bar__fill">
    {
      drawn.map((segment) => (
        <span
          class="bar__part"
          style={`--hue: ${segment.hue}; --share: ${segment.value / total}`}
        />
      ))
    }
  </span>
</span>

<style>
  .bar {
    position: relative;
    display: block;
    width: 100%;
    height: 6px;
    min-width: 4rem;
    /* The track shows through wherever nothing was answered, so a raider who replied to
       four raids of twenty reads as mostly empty rather than as a short bar. */
    border-radius: var(--radius-full);
    background: var(--raised);
    overflow: clip;
  }

  /*
   * The page's authored moment. Every bar draws itself in from the left on arrival, a
   * beat behind the one above it, so a panel assembles top-down and the shape of the
   * guild's season lands before any single number has been read.
   *
   * scaleX rather than width: this runs on up to forty rows at once, and animating
   * width would relayout the table on every frame of it.
   *
   * Its own curve rather than --ease. The surface's exponential ease-out is right for a
   * 120ms state change, where arriving instantly is the point; on a 460ms draw it puts
   * the bar at nine tenths of its length in the first hundred milliseconds and the
   * movement never reads. This one spends the time it was given.
   */
  .bar__fill {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    gap: 1px;
    transform-origin: left center;
    animation: bar-fill 460ms cubic-bezier(0.33, 0.86, 0.44, 1) var(--delay, 0ms) both;
  }

  @keyframes bar-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .bar__part {
    flex: var(--share) 1 0;
    background: var(--hue);
    /* Segments are compared against each other, so the smallest one still has to be
       findable. Below about two pixels a colour stops being a colour. */
    min-width: 2px;
  }

  /* Every bar is already at its full value in the default state, so dropping the
     animation leaves the page complete rather than empty. */
  @media (prefers-reduced-motion: reduce) {
    .bar__fill {
      animation: none;
    }
  }
</style>
