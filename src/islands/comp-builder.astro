  }

  .col__count {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  .col__list {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .col__empty {
    padding: 0.75rem 0.25rem;
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
    text-align: center;
  }

  /* A column that runs the width of the formation wraps across it, rather than stacking
     one name per row down a box wide enough for five. */
  .col--wide .col__list {
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
  }

  /* The tray follows the raid lead down the board: a raider being placed into ranged
     should not need a scroll back up to reach the pool. */
  .col--tray {
    position: sticky;
    top: calc(var(--nav-height) + 0.75rem);
    max-height: calc(100vh - var(--nav-height) - 2rem);
  }

  .col--tray .col__list {
    min-height: 0;
    overflow-y: auto;
  }

  /* -------------------------------------------------------------------- card */

  .card {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    width: 100%;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--raised);
    color: var(--text-primary);
    font: inherit;
    text-align: left;
    transition:
      background-color var(--dur-1) var(--ease),
