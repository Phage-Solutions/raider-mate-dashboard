  /* The raid, in formation. Tanks at the front where the marker is, damage behind
     them, healers at the back. It is the shape a raid actually stands in, so a raid
     lead reads the board as a pull rather than as four equal lists. */
  /* The raid, in formation. Tanks at the front where the marker is, damage behind
     them, healers at the back. It is the shape a raid actually stands in, so a raid
     lead reads the board as a pull rather than as four equal lists. */
  .board {
    position: relative;
    display: grid;
    grid-template-areas:
      'boss boss tray'
      'tank tank tray'
      'mdps rdps tray'
      'healer healer tray'
      'bench bench tray';
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 15rem;
    gap: 0.75rem;
    align-items: start;
  }

  /* The marker stands off the front line rather than sitting on it, which also gives
     the tank beams somewhere to be seen. */
  .encounter {
    position: relative;
    display: flex;
    grid-area: boss;
    justify-content: center;
    padding-bottom: 2.25rem;
  }

  /* Out of flow, so a long line cannot shove the marker off centre and take every beam
     with it. Neutral fill: a boss quote is not game data and not an action, so it gets
     no hue and certainly no amber. */
  /* Anchored by its bottom edge so a long line grows upward into empty space instead of
     downward into the beams.

     That edge sits at 1.5rem, which clears the marker's eastern spike: the crosshair
     ticks are at y=32 of a 64 viewBox drawn at 3.75rem, so the spike's centre line is
     1.875rem below the top of the band. */
  .quote {
    position: absolute;
    bottom: calc(100% - 1.5rem);
    left: calc(50% + 2.75rem);
    max-width: 20rem;
    margin: 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    opacity: 0;
    visibility: hidden;
    transform: translateY(3px);
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-2) var(--ease),
      visibility var(--dur-2);
  }

  .quote--on {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  /* The tail, pointing back down at whoever is talking. Sits at the bottom corner,
     which stays the one nearest the marker whatever the quote's length does above it. */
  .quote::before {
    content: '';
    position: absolute;
    bottom: 0.55rem;
    left: -5px;
    width: 8px;
    height: 8px;
    border-left: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    rotate: 45deg;
  }

  .quote {
    color: var(--text-secondary);
    font-size: var(--fs-sm);
    font-style: italic;
    line-height: 1.45;
  }

  @media (max-width: 52rem) {
    .quote {
      bottom: calc(100% - 1.2rem);
      left: 50%;
      max-width: min(20rem, 88%);
      translate: -50% 0;
    }

    .quote::before {
      display: none;
    }
  }

  /* Over the columns rather than behind them, because the formation stacks and a beam
     from the back line has to cross the front to reach the marker. Screen blending
     turns the strokes into light on a dark ground, so they pass over a card without
     taking anything away from the name on it. */
  .beams {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: visible;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  /* Global, and it has to be: these paths are built by the script, so they never carry
     the scoping attribute Astro puts on markup it rendered itself. Scoped, every rule
     here silently misses and the browser falls back to a black fill. */
  .beams :global(.beam__base) {
    fill: none;
    stroke: var(--hue);
    stroke-linecap: round;
    opacity: 0.14;
  }

  /* Nobody in this role, so the line behind the pulse is broken rather than solid.
     A gap in the comp looks like a gap. */
  .beams :global(.beam__base--empty) {
    stroke-dasharray: 3 7;
    opacity: 0.3;
  }

  /* The comet. Widths, opacities, dash lengths and timing are all set per segment by
     the script, which is the only place that knows how long each path actually is. */
  .beams :global(.beam__seg),
  .beams :global(.beam__glow) {
    fill: none;
    stroke: var(--hue);
    stroke-linecap: round;
  }

  /* The bloom, riding the head. Screen blending on the container makes this add light
     to the dark ground rather than paint a grey smear over it. */
  .beams :global(.beam__glow) {
    stroke-width: 9;
    opacity: 0.4;
    filter: blur(5px);
  }

  /* Nothing travels, so the script builds no comet at all: the still base line already
     says which roles are filled. */
  @media (prefers-reduced-motion: reduce) {
    .beams :global(.beam__base) {
      opacity: 0.4;
    }
  }

  .col {
    display: flex;
    flex-direction: column;
    min-height: 8rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface);
    transition:
      background-color var(--dur-2) var(--ease),
      border-color var(--dur-2) var(--ease);
  }

  /* The columns this raider said they can fill. Their own role colour, because it
     encodes a role; low enough to read as a hint rather than an instruction. Every
     column still takes every raider. */
  .col--declared {
    border-color: color-mix(in srgb, var(--hue) 40%, transparent);
    background: color-mix(in srgb, var(--hue) 6%, var(--surface));
  }

  /* Where the raider will land. Amber, because during a drag this is the only "where
     you are" on the screen. */
  .col--over {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--surface));
  }

  .col__head {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin: 0 0 0.625rem;
    padding: 0 0.25rem;
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
    font-weight: 560;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .col__dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: var(--radius-full);
