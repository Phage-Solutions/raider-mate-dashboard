# Caddy on :8080 in front of the Astro node process on 127.0.0.1:4321, both inside the
# one container. Scaleway's Serverless Containers run exactly one container per service
# and terminate TLS at the edge, forwarding plain HTTP inward.
#
# Everything below is policy the dashboard cannot set for itself: the headers have to be
# on the response before any page runs.
{
	# The edge already did TLS, and this process never sees the public hostname. Left on,
	# Caddy would try to provision a certificate for a name it does not have, on a port
	# nothing outside the container can reach.
	auto_https off

	# Nothing reconfigures this at runtime. An admin socket in the same container that
	# serves the public site is a second door for no benefit.
	admin off
	persist_config off
}

:8080 {
	encode zstd gzip

	header {
		# The dashboard renders a guild's roster and raid times. Nothing here belongs
		# in someone else's iframe or in a search index.
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin

		# No third-party scripts, no CDN, no remote images beyond Discord avatars.
		Content-Security-Policy "default-src 'self'; img-src 'self' https://cdn.discordapp.com data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'"

		-Server
	}

	reverse_proxy 127.0.0.1:4321 {
		# The scheme Caddy sees is not the scheme the browser used: Scaleway terminates
		# TLS at the edge and forwards plain HTTP inward. Astro compares the origin it
		# rebuilds from this against the Origin header on every POST, so getting it
		# wrong refuses every form in the product as a cross-site request.
		#
		# Set here rather than trusted from the edge, because trusting an inbound
		# X-Forwarded-Proto would let a client claim its own. Override it for a plain
		# HTTP deployment; docker-compose.yml does exactly that.
		header_up X-Forwarded-Proto {$PUBLIC_SCHEME:https}

		# Same reasoning for the host. Caddy replaces whatever the client sent with the
		# Host it actually served, which is what keeps allowedDomains: [{}] honest.
		#
		# hostport, not host: the latter drops the port, and the origin Astro rebuilds
		# then fails to match a browser sitting on any port but the default.
		header_up X-Forwarded-Host {hostport}
	}
}
