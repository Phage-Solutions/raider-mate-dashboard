# raider-mate-service, with no trailing /api. Inside docker compose, localhost is the
# dashboard container itself: point this at the service's container name on a shared
# network, or at host.docker.internal for a service running on the host.
SERVICE_BASE_URL=http://localhost:8080
# Must match SERVICE_API_KEY in the service's own .env
SERVICE_API_KEY=dev-local-key

# From https://discord.com/developers/applications. The redirect URI has to be
# registered there exactly as it reads here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4321/auth/callback

# 32 bytes, base64. Generate with: openssl rand -base64 32
# Changing it signs everyone out, which is the intended way to revoke every session.
SESSION_SECRET=

PORT=4321
HOST=127.0.0.1
